*DEFAULT;
DATA DANE.LOAN_default;
	SET DANE.LOAN;
	IF status IN('A','C') then default = 0;
	ELSE IF status IN('B','D') then default = 1;
	KEEP account_id default;
RUN;

*X1 - liczba lat od utworzenia konta;
DATA DANE.X1;
	SET DANE.ACCOUNT;
	years_since_creation = year(today()) - year(date);
	KEEP account_id years_since_creation;
RUN;
 
*X2 - kwartal zalozenia konta;
DATA DANE.X2;
	SET DANE.ACCOUNT;
	quarter = qtr(date);
	KEEP account_id quarter; 
RUN;

*X3 - miejsce przypisane do konta;
DATA DANE.X3;
	SET DANE.ACCOUNT;
	location = district_id;
	KEEP account_id location;
RUN;

*X4 - wiek klienta;
DATA DANE.X4;
	SET DANE.CLIENT;
	length year_of_birth 8.;
	year_of_birth = input(substr(put(birth_number, 8.), 3, 2), 2.);
	IF year_of_birth > 25 THEN year_of_birth = 1900 + year_of_birth;
	ELSE year_of_birth = 2000 + year_of_birth;
	age = year(today()) - year_of_birth;
	KEEP client_id age;
RUN;

DATA DANE.X4;
	MERGE DANE.X4 DANE.DISP;
	BY client_id;
	IF type = "OWNER" THEN output;
	KEEP account_id age;
RUN;

*X5 - plec klienta (0 - f, 1 - m);
DATA DANE.X5;
	SET DANE.CLIENT;
	gender = substr(put(birth_number,8.), 3, 2);
	IF gender > 50 THEN gender = 0;
	ELSE gender = 1;
	KEEP client_id gender;
RUN;

DATA DANE.X5;
	MERGE DANE.X5 DANE.DISP;
	BY client_id;
	IF type = "OWNER" THEN output;
	KEEP account_id gender;
RUN;

*X6 - typ karty;
DATA DANE.X6;
	SET DANE.CARD;
	card_type = type;
	KEEP card_type disp_id;
RUN;

DATA DANE.X6;
	MERGE DANE.X6 DANE.DISP;
	IF type = "OWNER" THEN output;
	KEEP account_id card_type;
RUN;

*X7 - rok wydania karty;
DATA DANE.X7;
	SET DANE.CARD;
	card_issued_year = input(substr(put(issued, 8.), 3, 2), 2.);
	IF card_issued_year > 25 THEN card_issued_year = 1900 + card_issued_year;
	ELSE card_issued_year = 2000 + card_issued_year;
	KEEP card_id card_issued_year;
RUN;

DATA DANE.X7;
	MERGE DANE.X7 DANE.DISP;
	IF type = "OWNER" THEN output;
	KEEP account_id card_issued_year;
RUN;

*X8 - liczba transakcji;
PROC SORT data = DANE.TRANS out = DANE.TRANS;
	BY account_id amount;
RUN; 

DATA DANE.X8;
	SET DANE.TRANS;
	BY account_id;
	IF FIRST.account_id THEN count_trans = 0;
	count_trans + 1;
	IF LAST.account_id THEN output;
	KEEP account_id count_trans;
RUN;

*X9 - suma transakcji;
DATA DANE.X9;
	SET DANE.TRANS;
	BY account_id;
	IF FIRST.account_id THEN sum_trans = 0;
	sum_trans + amount;
	IF LAST.account_id THEN output;
	KEEP account_id sum_trans;
RUN;

*X10 - srednia transakcji;
DATA DANE.X10;
	MERGE DANE.X8 DANE.X9;
	BY account_id;
	avg_trans = sum_trans / count_trans;
	KEEP account_id avg_trans;
RUN;


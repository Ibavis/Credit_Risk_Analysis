*FORMAT PUSTYCH DANYCH;
DATA DANE.ALL;
	SET DANE.ALL;
	IF insurance = . THEN insurance = 0;
	IF houses = . THEN houses = 0;
	IF leasings = . THEN leasings = 0;
	IF pension = . THEN pension = 0;
	IF card_type = " " THEN card_type = "-";
	IF card_issued_year = . THEN card_issued_year = 0;
	IF loan_amount = . THEN loan_amount = 0;
	IF loan_duration = . THEN loan_duration = 0;
	IF monthly_payment = . THEN monthly_payment = 0;
	IF status = " " THEN status = "-";
RUN;


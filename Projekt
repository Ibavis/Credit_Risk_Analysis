PROC SQL;
	CREATE TABLE DANE.X27 AS
	SELECT account_id, COUNT(CASE WHEN k_symbol="SIPO" THEN account_id ELSE . END) AS houses
	FROM DANE.ORDER
	GROUP BY account_id;
QUIT;

